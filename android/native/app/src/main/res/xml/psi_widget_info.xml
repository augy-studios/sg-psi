<?xml version="1.0" encoding="utf-8"?>
<!-- The SG PSI widget (PsiWidget.java, RegionWidget.java). Resizable either way; one row of
     cells high, it drops the regions. A region is picked as it's added (WidgetConfigActivity),
     and again from Android 12's reconfigure or the widget's title. Refreshed by ReadingsWorker,
     not by updatePeriodMillis. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_psi"
    android:previewLayout="@layout/widget_psi"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:configure="org.uwuapps.sgpsi.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
