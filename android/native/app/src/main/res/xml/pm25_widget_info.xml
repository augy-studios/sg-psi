<?xml version="1.0" encoding="utf-8"?>
<!-- The SG PM2.5 widget (Pm25Widget.java, RegionWidget.java): the same layout as SG PSI's, a
     region picked as it's added (WidgetConfigActivity). Refreshed by ReadingsWorker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_psi"
    android:previewLayout="@layout/widget_psi"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/pm25_widget_description"
    android:configure="org.uwuapps.sgpsi.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen" />
