# Copy to .env.local for `vercel dev`, and set the same names under the Vercel
# project's Settings, Environment Variables for deploys. `vercel env pull
# .env.local` fetches them from there. Never commit the filled in copy.

# ---- data.gov.sg ----

# API key for the real-time PSI, PM2.5 and wind feeds. Optional: without it the
# readings still come, at data.gov.sg's lower rate limit.
DATA_GOV_KEY=

# ---- Supabase: the hourly history behind Trends and the Wind chart ----

# Run migrations/001_sgpsi_schema.sql in the Supabase SQL editor first. Leave
# both blank and the charts fall back to asking data.gov.sg for each day, with
# no wind history. The service role key bypasses row level security, so it
# belongs in Vercel and nowhere else.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Vercel Cron ----

# Any long random string, e.g. from `openssl rand -hex 32`. Vercel Cron sends it
# to /api/cron/collect, which refuses calls without it. Without it nothing is
# collected and no alerts are sent.
CRON_SECRET=

# ---- PSI alerts (web push). See main-site/README.md, "PSI alerts". ----

# Upstash Redis. Connecting it from the Vercel Marketplace sets these two; the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN pair from upstash.com works too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# From `npx web-push generate-vapid-keys`. Generate once and keep them: new
# keys invalidate every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# How push services can reach you if something goes wrong. mailto: or https:.
VAPID_SUBJECT=mailto:you@example.com
